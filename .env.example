# Conexión a PostgreSQL local, el mismo que se administra con pgAdmin 4.
# Copiar este archivo como .env y completar DB_PASSWORD (la contraseña del usuario de Postgres).
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=proyecto
DB_SSL=false

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h

FRONTEND_URL=http://localhost:5173
