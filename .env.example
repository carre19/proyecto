# Conexión a PostgreSQL local, el mismo que se administra con pgAdmin 4.
# Copiar este archivo como .env y completar DB_PASSWORD (la contraseña del usuario de Postgres).
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=proyecto
DB_SSL=false

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h

FRONTEND_URL=http://localhost:5173

# Carpeta donde se guardan las imágenes subidas (opcional; por defecto "uploads" dentro del proyecto)
#UPLOADS_DIR=uploads

# ---------- Ventas y pagos (fases 2 y 3) ----------
# Cargo de la plataforma sobre las compras de la página, en %. Lo paga el cliente.
#PORCENTAJE_PLATAFORMA=6
# Minutos que tiene el cliente para pagar antes de que se libere el cupo.
#MINUTOS_RESERVA=30
# Máximo de compras por dirección IP cada 10 minutos (frena las compras falsas).
#LIMITE_COMPRAS=30
# Confirmación automática de transferencias: el servicio que detecta el pago llama a POST /api/pagos/webhook
# con la cabecera X-Firma = HMAC-SHA256 (hex) del cuerpo, usando este secreto. Sin secreto, el aviso queda apagado.
#PAGOS_WEBHOOK_SECRET=
# Avisos al cliente: cualquier servicio que reciba un POST con JSON. Sin estas variables los avisos quedan "simulados".
#WHATSAPP_API_URL=
#WHATSAPP_API_TOKEN=
#EMAIL_API_URL=
#EMAIL_API_TOKEN=
# Dirección pública del front, para los links de los avisos (por defecto FRONTEND_URL).
#FRONTEND_PUBLIC_URL=
# Si corrés varias copias del servidor, dejá las tareas periódicas (avisos y vencimientos) en una sola: TAREAS_AUTO=false en las demás.
#TAREAS_AUTO=true
